---
interface Props {
  variant?: "now" | "browse" | "speakers";
  art: string;
  art2?: string;
  title: string;
  creator?: string;
}
const { variant = "now", art, art2, title, creator } = Astro.props;
---

<div class="device" aria-hidden="true">
  <div class="device-screen">
    {
      variant === "browse" && (
        <div class="device-browse">
          <p class="device-kicker">Today</p>
          <img src={art} alt="" width="320" height="180" />
          <img src={art2} alt="" width="320" height="180" />
        </div>
      )
    }
    {
      variant === "speakers" && (
        <div class="device-speakers">
          <p class="device-kicker">Cast to</p>
          <div class="device-row is-on">
            <span>Living room</span>
            <span class="device-check"></span>
          </div>
          <div class="device-row">
            <span>Kitchen group</span>
          </div>
        </div>
      )
    }
    {
      variant === "now" && (
        <div class="device-now">
          <img src={art} alt="" width="320" height="180" />
          <p class="device-title">{title}</p>
          {creator && <p class="device-creator">{creator}</p>}
          <div class="device-progress"><span></span></div>
          <div class="device-transport"><span class="pause"></span></div>
          <p class="device-cast">Living room</p>
        </div>
      )
    }
  </div>
</div>
