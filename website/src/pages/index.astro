---
import Base from "../layouts/Base.astro";
import Icons from "../components/Icons.astro";
import Receiver from "../components/Receiver.astro";
import MacBook from "../components/MacBook.astro";
import { art, downloads, featured } from "../data/site";

const now = featured.nowPlaying;
const promise = ["Free and open source", "No ads", "No accounts", "No subscriptions"];
---

<Base title="Moozaq — Set the mood. Let it play.">
  <Icons />

  <header class="site-header">
    <div class="wrap header-inner">
      <a href="#content" aria-label="Moozaq home"><span class="wm" style="width:128px"></span></a>
      <nav class="nav" aria-label="Page">
        <a href="#moods">The moods</a>
        <a href="#playing">How it works</a>
        <a href="#speakers">Your speakers</a>
      </nav>
      <a class="btn" href="#get">Download</a>
    </div>
  </header>

  <main id="content">
    <section class="wrap hero">
      <div class="hero-copy">
        <p class="label">For Google Nest &amp; Cast speakers</p>
        <h1>Set the mood. <span>Let it play.</span></h1>
        <p class="lede">Long, unhurried vibes for whatever you're getting into. Choose a mood, play it on your home speakers, and make yourself at home.</p>
        <ul class="promise" aria-label="What it costs">
          {promise.map((p) => <li>{p}</li>)}
        </ul>
        <div class="hero-actions">
          <a class="btn" href={downloads.android}><svg aria-hidden="true"><use href="#i-android"></use></svg>Get it for Android</a>
          <a class="btn" href={downloads.mac}><svg aria-hidden="true"><use href="#i-mac"></use></svg>Get it for Mac</a>
        </div>
      </div>

      <div class="stage" aria-hidden="true">
        <svg class="sun" viewBox="0 0 400 210"><use href="#sun"></use></svg>
        <figure class="peek peek-l"><img src={art(featured.heroLeft.id)} alt="" width="1280" height="720" fetchpriority="high" /></figure>
        <figure class="peek peek-r"><img src={art(featured.heroRight.id)} alt="" width="1280" height="720" /></figure>
        <div class="phone">
          <div class="phone-bar"><span>9:41</span><span></span></div>
          <div class="np">
            <img class="np-art" src={art(now.id)} alt="" width="1280" height="720" />
            <div><div class="np-title">{now.label}</div><div class="np-by">{now.creator}</div></div>
            <div class="bar"></div>
            <div class="times"><span>1:12:40</span><span>3:33:00</span></div>
            <div class="controls"><i class="prev"></i><span class="pause"></span><i class="next"></i></div>
            <div class="vol"><svg><use href="#i-vol"></use></svg><div class="bar"></div></div>
            <span class="cast-chip"><svg><use href="#i-speaker"></use></svg>Living room</span>
          </div>
        </div>
      </div>
    </section>

    <Receiver />

    <section class="section" id="length">
      <div class="wrap runtime">
        <div class="section-head">
          <p class="label">Run time</p>
          <h2>Long vibes. Less choosing.</h2>
          <p>Settle into a sound for an hour or more. From the first coffee to the last page, there's room to stay with the feeling.</p>
        </div>
        <div>
          <div class="chart">
            <div class="chart-row">
              <div class="chart-name">A Moozaq vibe<small>Most run an hour or more</small></div>
              <div class="track"><span class="fill range" style="--from:25%"></span></div>
              <div class="chart-val">1 h – 4 h+</div>
            </div>
            <div class="chart-row song">
              <div class="chart-name">A typical song<small>For scale</small></div>
              <div class="track"><span class="fill" style="--w:1.46%"></span></div>
              <div class="chart-val">3–4 min</div>
            </div>
          </div>
          <div class="axis" aria-hidden="true">
            <span></span>
            <div class="axis-ticks"><span style="left:0">0</span><span style="left:25%">1 h</span><span style="left:50%">2 h</span><span style="left:75%">3 h</span><span style="left:100%">4 h</span></div>
            <span></span>
          </div>
          <p class="chart-note">Drawn to scale. Many vibes go on for several hours, and the app shows each run time before you press play.</p>
        </div>
      </div>
    </section>

    <section class="section how" id="playing">
      <div class="wrap">
        <div class="section-head">
          <p class="label">How it works</p>
          <h2>Pick a feeling. Fill the room.</h2>
          <p>Your phone or Mac is the remote, not the record player. The music plays on the speakers.</p>
        </div>
        <ol class="steps">
          <li class="step">
            <div class="phone" aria-hidden="true">
              <div class="phone-bar"><span>9:41</span><span></span></div>
              <h4>Today</h4>
              <div class="chips"><span>Focus</span><span class="on">Morning</span><span>Cooking</span><span>Late</span></div>
              {featured.browse.map((v) => (
                <div class="tile"><img src={art(v.id)} alt="" width="1280" height="720" loading="lazy" decoding="async" /><b>{v.label}</b><span>{v.creator}</span></div>
              ))}
            </div>
            <span class="step-num">1</span>
            <h3>Find your mood</h3>
            <p>Start from the feeling of the moment, then choose a vibe that suits it.</p>
          </li>
          <li class="step">
            <div class="phone" aria-hidden="true">
              <div class="phone-bar"><span>9:41</span><span></span></div>
              <h4>Play on</h4>
              <div class="cast-list">
                <div class="cast-row on"><svg><use href="#i-speaker"></use></svg><div>Living room<small>Speaker</small></div><span class="tick"></span></div>
                <div class="cast-row"><svg><use href="#i-speaker"></use></svg><div>Kitchen<small>Speaker</small></div><span class="tick"></span></div>
                <div class="cast-row"><svg><use href="#i-speaker"></use></svg><div>Bedroom<small>Speaker</small></div><span class="tick"></span></div>
                <div class="cast-row"><svg><use href="#i-group"></use></svg><div>Downstairs<small>Saved group</small></div><span class="tick"></span></div>
              </div>
            </div>
            <span class="step-num">2</span>
            <h3>Choose your speakers</h3>
            <p>Pick a Google Nest or compatible Google Cast speaker, or a saved group.</p>
          </li>
          <li class="step">
            <div class="phone" aria-hidden="true">
              <div class="phone-bar"><span>9:41</span><span></span></div>
              <div class="np">
                <img class="np-art" src={art(now.id)} alt="" width="1280" height="720" loading="lazy" decoding="async" />
                <div><div class="np-title">{now.label}</div><div class="np-by">{now.creator}</div></div>
                <div class="bar" style="--left:97%"></div>
                <div class="times"><span>0:04:12</span><span>3:33:00</span></div>
                <div class="controls"><i class="prev"></i><span class="pause"></span><i class="next"></i></div>
              </div>
            </div>
            <span class="step-num">3</span>
            <h3>Press play</h3>
            <p>Put the phone down. Open the app again when you want to change the vibe, the volume, or stop.</p>
          </li>
        </ol>
      </div>
    </section>

    <section class="section" id="mac">
      <div class="wrap on-mac">
        <div class="section-head">
          <p class="label">On your Mac</p>
          <h2>Play it from your desk.</h2>
          <p>Moozaq for Mac has the same moods and the same speakers. Browse, choose where it plays, and set the volume without reaching for your phone.</p>
          <a class="btn" href={downloads.mac}><svg aria-hidden="true"><use href="#i-mac"></use></svg>Get it for Mac</a>
        </div>
        <MacBook />
      </div>
    </section>

    <section class="section" id="speakers">
      <div class="wrap practical">
        <div class="practical-left">
          <p class="label">Your speakers</p>
          <h2>At home on your home speakers.</h2>
          <p>Moozaq plays on Google Nest and compatible Google Cast speakers. Check the speakers you have at home before you install.</p>
          <dl class="spec">
            <div><dt>Plays on</dt><dd>Google Nest and compatible Google Cast speakers, including saved speaker groups</dd></div>
            <div><dt>Coming</dt><dd>Sonos <span class="soon">Soon</span></dd></div>
            <div><dt>Remote</dt><dd>Android phone or Mac</dd></div>
            <div><dt>Length</dt><dd>Most run an hour or more, many for several hours</dd></div>
            <div><dt>Price</dt><dd>Free and open source</dd></div>
            <div><dt>Not needed</dt><dd>An account, a subscription, or YouTube Premium</dd></div>
          </dl>
        </div>
        <div class="faq-list" id="questions">
          <h3>A few practical things</h3>
          <details open>
            <summary>Does it cost anything?</summary>
            <p>No. Moozaq is free and open source. No ads, no accounts, and no subscriptions.</p>
          </details>
          <details>
            <summary>Can I use it on my Mac?</summary>
            <p>Yes. Moozaq is available for Android and for Mac. There is no iPhone app.</p>
          </details>
          <details>
            <summary>Which speakers does it work with?</summary>
            <p>Google Nest and compatible Google Cast speakers, including speaker groups you've saved. Support for Sonos is coming soon.</p>
          </details>
          <details>
            <summary>Do I need an account?</summary>
            <p>No. There is no account to create, and no subscription to start.</p>
          </details>
          <details>
            <summary>What kind of music will I find?</summary>
            <p>Long vibes across moods and genres, from cozy jazz and vintage lounge to psychedelic dub and more. The selection can grow over time.</p>
          </details>
          <details>
            <summary>How long are the vibes?</summary>
            <p>Most vibes run for at least an hour, and many are made for several hours of listening. The length is shown before you play.</p>
          </details>
          <details>
            <summary>Where do the vibes come from?</summary>
            <p>They come from YouTube channels and videos. Moozaq shows the creator, original title, artwork and length so you can see whose music you are playing.</p>
          </details>
        </div>
      </div>
    </section>

    <section class="close" id="get">
      <svg class="close-sun" viewBox="0 0 400 210" aria-hidden="true" style="transform:scaleY(-1)"><use href="#sun"></use></svg>
      <div class="wrap close-inner">
        <img src="/brand/wordmark-neon.svg" alt="Moozaq" width="720" height="188" loading="lazy" />
        <h2>Give your room a different feeling.</h2>
        <p class="brand-line">Find your mood. Let it run.</p>
        <ul class="promise" aria-label="What it costs">
          {promise.map((p) => <li>{p}</li>)}
        </ul>
        <div class="close-actions">
          <a class="btn" href={downloads.android}><svg aria-hidden="true"><use href="#i-android"></use></svg>Get it for Android</a>
          <a class="btn" href={downloads.mac}><svg aria-hidden="true"><use href="#i-mac"></use></svg>Get it for Mac</a>
        </div>
        <p class="close-note">Download links arrive with the first public release.</p>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="wrap footer-inner">
      <span class="wm" role="img" aria-label="Moozaq"></span>
      <span>For Android and Mac. Free and open source. No ads, accounts, or subscriptions.</span>
    </div>
  </footer>
</Base>
