{
  "$description": "Moozaq UI, Material 3 dark scheme. Primary seed #FFB56B (amber), neutral seed #1B2029 (navy), generated with @material/material-color-utilities 0.3.0.",
  "fontFamily": "'Roboto Flex', Roboto, system-ui, sans-serif",
  "color": {
    "primary": "#FFB872",
    "onPrimary": "#4A2800",
    "primaryContainer": "#6A3C00",
    "onPrimaryContainer": "#FFDCBE",
    "secondaryContainer": "#59422D",
