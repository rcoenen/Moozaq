    "bodyMedium": {
      "fontSize": 14,
      "lineHeight": 20,
      "fontWeight": 400,
      "letterSpacing": 0.25
    },
    "labelLarge": {
      "fontSize": 14,
      "lineHeight": 20,
      "fontWeight": 500,
      "letterSpacing": 0.1
